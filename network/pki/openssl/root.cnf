[ default ]
default_ca = CA_default
[ ca ]
default_ca = CA_default
[ CA_default ]
dir               = $ENV::PKI_OUT
certs             = $dir/certs
crl_dir           = $dir/crl
new_certs_dir     = $dir/newcerts
database          = $dir/index.txt
serial            = $dir/serial
private_key       = $dir/private/root.key.pem
certificate       = $dir/certs/root.cert.pem
crlnumber         = $dir/crlnumber
crl               = $dir/crl/root.crl.pem
crl_extensions    = crl_ext
default_crl_days  = 30
default_md        = sha256
name_opt          = ca_default
cert_opt          = ca_default
default_days      = 1825
preserve          = no
policy            = policy_strict
copy_extensions   = none

# Permit reissuing for a subject that already has a certificate. Renewal and
# key rotation both produce a second certificate with an identical subject,
# and openssl refuses that by default.
unique_subject    = no
[ policy_strict ]
countryName            = match
organizationName       = supplied
organizationalUnitName = optional
commonName             = supplied
[ req ]
prompt             = no
distinguished_name = req_distinguished_name
string_mask        = utf8only
default_md         = sha256
[ req_distinguished_name ]
countryName            = $ENV::CERT_C
organizationName       = $ENV::CERT_O
organizationalUnitName = $ENV::CERT_OU
commonName             = $ENV::CERT_CN
[ v3_root_ca ]
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always,issuer
basicConstraints       = critical, CA:true, pathlen:1
keyUsage               = critical, cRLSign, keyCertSign
[ crl_ext ]
authorityKeyIdentifier = keyid:always
